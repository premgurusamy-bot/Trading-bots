# Transport ERP settings. Copy to .env (setup.bat does this) and edit.
# Claude API key from https://platform.claude.com -> API keys.
# Leave empty to run in RULES mode: invoicing, dispatch, alerts, reminders and
# reports still run automatically, but no AI writing/reasoning happens.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high  (higher = smarter but more tokens)
AI_EFFORT=medium
# Port for the web app (opens on http://127.0.0.1:PORT)
APP_PORT=8100
# Optional: Zapier / Make / n8n webhook that actually sends approved emails,
# WhatsApp messages and social posts. Leave empty to keep them in the Outbox.
OUTBOX_WEBHOOK_URL=
# Optional login password for the web app (recommended if others use your PC/network)
ERP_PASSWORD=
