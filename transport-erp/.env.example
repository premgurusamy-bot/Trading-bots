# Transport ERP settings. setup.bat copies this to .env. Edit .env in Notepad.

# ---- AI engines (set one or both; with neither, the ERP runs in RULES mode) ----
# Claude: key from https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high  (higher = smarter, more tokens)
AI_EFFORT=medium
# ChatGPT: key from https://platform.openai.com -> API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Which engine roles use when set to "Auto": auto | claude | openai
AI_PROVIDER=auto

# ---- Canva (optional). Create an integration at https://www.canva.com/developers ----
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must match the redirect URL registered in Canva. Default: http://127.0.0.1:APP_PORT/api/canva/callback
CANVA_REDIRECT_URI=

# ---- App ----
APP_PORT=8100
# Login password. REQUIRED for the phone app / network access (start-mobile.bat)
ERP_PASSWORD=
# Public address of this ERP if hosted online (used for image links in posts), e.g. https://erp.mycompany.com
PUBLIC_URL=
# Zapier / Make / n8n webhook that actually sends approved emails, WhatsApp and social posts
OUTBOX_WEBHOOK_URL=
# 1 = add demo records on first start
ERP_DEMO_DATA=1
