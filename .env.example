# Copy to .env (setup.bat does this). .env is git-ignored. Placeholders only — never commit real values.

# Where the dashboard listens. 127.0.0.1 = this PC only (safest).
# To open it from your phone on the same Wi-Fi, use 0.0.0.0 (login is always required; never port-forward to the internet).
APP_HOST=127.0.0.1
APP_PORT=8000

# Market data: "dhan" (live Dhan feed) or "off".
MARKET_DATA_MODE=dhan
CHAIN_POLL_SECONDS=5

# LIVE TRADING FEATURE FLAG. Leave false. Even when true, live trading must ALSO be enabled in
# Settings with your password and a typed acknowledgement, and every order needs your confirmation.
LIVE_TRADING_FEATURE_FLAG=false

# Optional fallback ONLY if Windows Credential Manager is unavailable. Prefer Settings -> Dhan credentials.
# DHAN_CLIENT_ID=your-client-id
# DHAN_ACCESS_TOKEN=paste-token-here

LOG_LEVEL=INFO
