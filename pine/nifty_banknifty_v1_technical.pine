//@version=6
// ============================================================================
// NIFTY / BANK NIFTY — Strategy V1.0 — TECHNICAL-ONLY COMPANION
// ----------------------------------------------------------------------------
// * Visual reference only. The Python engine (with Dhan option-chain data) is the
//   FINAL decision authority. This script CANNOT see the option chain, OI, PCR,
//   Max Pain, Greeks, IV, bid/ask or liquidity: Pine cannot call the Dhan API.
//   Those conditions are shown as EXTERNAL in the status table and are never
//   assumed to pass.
// * Use on the INDEX chart (e.g. NSE:NIFTY / NSE:BANKNIFTY) at the 5-minute timeframe.
//   Index spot has no volume, so volume/VWAP use the futures symbol input
//   (default continuous current-month futures, e.g. NSE:NIFTY1!).
// * Non-repainting: signals only on confirmed (closed) bars; higher-timeframe and
//   daily values use the previous COMPLETED bar ([1] + lookahead_on idiom);
//   pivots are used only after confirmation (5 bars to the right).
// * The 100-point score is NOT computed here: 35 of its points depend on
//   option-chain/Greeks data. Technical components only are displayed.
// ============================================================================
indicator("V1.0 Technical Companion (NIFTY/BANKNIFTY)", shorttitle="V1.0 Tech", overlay=true, max_lines_count=200, max_labels_count=200)

// ---------------- SPEC inputs (frozen V1.0 defaults) ----------------
emaFastLen = input.int(9, "Fast EMA", group="V1.0 spec")
emaSlowLen = input.int(20, "Slow EMA", group="V1.0 spec")
atrLen     = input.int(14, "ATR", group="V1.0 spec")
volLen     = input.int(20, "Volume SMA", group="V1.0 spec")
adxLen     = input.int(14, "ADX", group="V1.0 spec")
pivLen     = input.int(5, "Confirmed pivot length", group="V1.0 spec")
validity   = input.int(3, "Signal validity (completed 5m candles)", group="V1.0 spec")
// ---------------- implementer defaults (same as Python IMPL params) ----------------
adxMin       = input.float(20.0, "ADX minimum (sideways filter)", group="Implementer defaults")
slopeLb      = input.int(3, "EMA9 slope lookback", group="Implementer defaults")
flatFrac     = input.float(0.05, "Flat slope (x ATR per bar)", group="Implementer defaults")
sideLb       = input.int(12, "Sideways lookback (bars)", group="Implementer defaults")
maxEmaX      = input.int(2, "Max EMA crosses", group="Implementer defaults")
maxVwapX     = input.int(3, "Max VWAP crosses", group="Implementer defaults")
touchFrac    = input.float(0.30, "Level touch tolerance (x ATR)", group="Implementer defaults")
slBuf        = input.float(0.10, "SL ATR buffer", group="Implementer defaults")
maxCandleAtr = input.float(1.5, "Max confirmation candle range (x ATR)", group="Implementer defaults")
maxExtAtr    = input.float(1.5, "Max trigger distance from EMA9 (x ATR)", group="Implementer defaults")
volMult      = input.float(1.0, "Volume confirmation (x SMA20)", group="Implementer defaults")
futSym       = input.symbol("NSE:NIFTY1!", "Futures symbol for volume/VWAP", group="Data")
orMinutes    = input.int(15, "Opening range minutes", group="Implementer defaults")
showLevels   = input.bool(true, "Show PDH/PDL/PDC, OR, fib, pivots", group="Display")

// ---------------- core series ----------------
emaF = ta.ema(close, emaFastLen)
emaS = ta.ema(close, emaSlowLen)
atr  = ta.atr(atrLen)
[diP, diM, adx] = ta.dmi(adxLen, adxLen)

// 15m EMAs from the last COMPLETED 15m bar (no look-ahead)
emaF15 = request.security(syminfo.tickerid, "15", ta.ema(close, emaFastLen)[1], lookahead=barmerge.lookahead_on)
emaS15 = request.security(syminfo.tickerid, "15", ta.ema(close, emaSlowLen)[1], lookahead=barmerge.lookahead_on)

// Futures volume aligned to this chart's bars (same timeframe; no look-ahead)
fVol = request.security(futSym, timeframe.period, volume, lookahead=barmerge.lookahead_off)
volOk = not na(fVol) and fVol > 0
vSma = ta.sma(fVol, volLen)

// Session VWAP: index typical price weighted by futures volume, reset daily
newDay = timeframe.change("D")
var float cumPV = 0.0
var float cumV = 0.0
if newDay
    cumPV := 0.0
    cumV := 0.0
if volOk
    cumPV += hlc3 * fVol
    cumV += fVol
vwap = cumV > 0 ? cumPV / cumV : na

// Previous-day levels from the previous COMPLETED daily bar
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
pdc = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

// Opening range (first orMinutes of the session), valid only after it completes
var float orh = na
var float orl = na
var int orStart = na
if newDay
    orh := high
    orl := low
    orStart := time
else if not na(orStart) and time < orStart + orMinutes * 60000
    orh := math.max(orh, high)
    orl := math.min(orl, low)
orDone = not na(orStart) and time >= orStart + orMinutes * 60000

// Confirmed pivots (known pivLen bars after the pivot bar)
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var float lastH = na
var float prevH = na
var float lastL = na
var float prevL = na
var int lastHBar = na
var int lastLBar = na
if not na(ph)
    prevH := lastH
    lastH := ph
    lastHBar := bar_index - pivLen
if not na(pl)
    prevL := lastL
    lastL := pl
    lastLBar := bar_index - pivLen

// Structure breaks: completed close beyond the last confirmed swing
bearBreak = not na(lastL) and close < lastL
bullBreak = not na(lastH) and close > lastH
var bool bearBroken = false
var bool bullBroken = false
if not na(pl)
    bearBroken := false
if not na(ph)
    bullBroken := false
if bearBreak
    bearBroken := true
if bullBreak
    bullBroken := true
upStruct = not na(prevH) and not na(prevL) and lastH > prevH and lastL > prevL
dnStruct = not na(prevH) and not na(prevL) and lastH < prevH and lastL < prevL

// Fibonacci of the latest confirmed leg
legUp = not na(lastHBar) and not na(lastLBar) and lastLBar < lastHBar
rng = lastH - lastL
fibLvl(ratio) => legUp ? lastH - ratio * rng : lastL + ratio * rng

// ---------------- trend & sideways filters ----------------
slope = (emaF - emaF[slopeLb]) / slopeLb
flatThr = flatFrac * atr
emaCross = 0
vwapCross = 0
for i = 0 to sideLb - 2
    if (emaF[i] - emaS[i]) * (emaF[i + 1] - emaS[i + 1]) < 0
        emaCross += 1
    if not na(vwap[i]) and not na(vwap[i + 1]) and (close[i] - vwap[i]) * (close[i + 1] - vwap[i + 1]) < 0
        vwapCross += 1
sideways = adx < adxMin or emaCross > maxEmaX or vwapCross > maxVwapX or math.abs(slope) <= flatThr or not (upStruct or dnStruct)

bullTrend = emaF15 > emaS15 and emaF > emaS and not na(vwap) and close > vwap and slope > flatThr and not bearBroken and not sideways
bearTrend = emaF15 < emaS15 and emaF < emaS and not na(vwap) and close < vwap and slope < -flatThr and not bullBroken and not sideways

// ---------------- rejection patterns (same thresholds as Python patterns.py) ----------------
body = math.abs(close - open)
rngC = high - low
upW = high - math.max(open, close)
loW = math.min(open, close) - low
cl = rngC > 0 ? (close - low) / rngC : 0.5
hammer = rngC > 0 and loW >= 2 * math.max(body, 0.05 * rngC) and upW <= 0.25 * rngC and cl >= 0.60
shooting = rngC > 0 and upW >= 2 * math.max(body, 0.05 * rngC) and loW <= 0.25 * rngC and cl <= 0.40
bullPin = rngC > 0 and loW >= 0.66 * rngC and body <= 0.30 * rngC
bearPin = rngC > 0 and upW >= 0.66 * rngC and body <= 0.30 * rngC
bullEng = close[1] < open[1] and close > open and open <= close[1] and close >= open[1] and body > math.abs(close[1] - open[1])
bearEng = close[1] > open[1] and close < open and open >= close[1] and close <= open[1] and body > math.abs(close[1] - open[1])
b2 = math.abs(close[2] - open[2])
mStar = close[2] < open[2] and b2 >= 0.5 * (high[2] - low[2]) and math.abs(close[1] - open[1]) <= 0.3 * b2 and close > open and close > (open[2] + close[2]) / 2
eStar = close[2] > open[2] and b2 >= 0.5 * (high[2] - low[2]) and math.abs(close[1] - open[1]) <= 0.3 * b2 and close < open and close < (open[2] + close[2]) / 2
bullRej = hammer or bullPin or bullEng or mStar
bearRej = shooting or bearPin or bearEng or eStar

// ---------------- reaction at a level (technical families only) ----------------
tol = touchFrac * atr
probeLo = math.min(low, low[1])
probeHi = math.max(high, high[1])
nearSup(lv) => not na(lv) and probeLo <= lv + tol and close > lv and lv >= probeLo - tol
nearRes(lv) => not na(lv) and probeHi >= lv - tol and close < lv and lv <= probeHi + tol
supHit = nearSup(vwap) or nearSup(emaS) or nearSup(lastL) or nearSup(pdl) or nearSup(pdc) or (orDone and nearSup(orl)) or (legUp and (nearSup(fibLvl(0.382)) or nearSup(fibLvl(0.5)) or nearSup(fibLvl(0.618)) or nearSup(fibLvl(0.786))))
resHit = nearRes(vwap) or nearRes(emaS) or nearRes(lastH) or nearRes(pdh) or nearRes(pdc) or (orDone and nearRes(orh)) or (not legUp and (nearRes(fibLvl(0.382)) or nearRes(fibLvl(0.5)) or nearRes(fibLvl(0.618)) or nearRes(fibLvl(0.786))))

volConfirm = volOk and not na(vSma) and fVol >= volMult * vSma
notChasingBull = rngC <= maxCandleAtr * atr and (high - emaF) <= maxExtAtr * atr
notChasingBear = rngC <= maxCandleAtr * atr and (emaF - low) <= maxExtAtr * atr

// ---------------- technical candidates (confirmed bars only) ----------------
bullCand = barstate.isconfirmed and bullTrend and supHit and bullRej and volConfirm and notChasingBull
bearCand = barstate.isconfirmed and bearTrend and resHit and bearRej and volConfirm and notChasingBear

// Plan levels for the most recent candidate (underlying only)
var float trig = na
var float sl = na
var int candBar = na
var bool candBull = false
if bullCand
    trig := high + syminfo.mintick
    sl := low - slBuf * atr
    candBar := bar_index
    candBull := true
if bearCand
    trig := low - syminfo.mintick
    sl := high + slBuf * atr
    candBar := bar_index
    candBull := false
alive = not na(candBar) and bar_index - candBar <= validity
riskPts = math.abs(trig - sl)

plot(emaF, "EMA 9", color.new(color.green, 0), 2)
plot(emaS, "EMA 20", color.new(color.orange, 0), 2)
plot(vwap, "Session VWAP (futures volume)", color.new(color.blue, 0), 2, style=plot.style_linebr)
plot(showLevels ? pdh : na, "PDH", color.new(color.purple, 30), 1, style=plot.style_linebr)
plot(showLevels ? pdl : na, "PDL", color.new(color.purple, 30), 1, style=plot.style_linebr)
plot(showLevels ? pdc : na, "PDC", color.new(color.purple, 60), 1, style=plot.style_linebr)
plot(showLevels and orDone ? orh : na, "OR high", color.new(color.yellow, 20), 1, style=plot.style_linebr)
plot(showLevels and orDone ? orl : na, "OR low", color.new(color.yellow, 20), 1, style=plot.style_linebr)
plot(showLevels ? fibLvl(0.5) : na, "Fib 50%", color.new(color.olive, 50), 1, style=plot.style_linebr)
plot(showLevels ? fibLvl(0.618) : na, "Fib 61.8%", color.new(color.olive, 50), 1, style=plot.style_linebr)
plotshape(showLevels and not na(ph), "Confirmed swing high", shape.triangledown, location.abovebar, color.gray, offset=-pivLen, size=size.tiny)
plotshape(showLevels and not na(pl), "Confirmed swing low", shape.triangleup, location.belowbar, color.gray, offset=-pivLen, size=size.tiny)
plotshape(bullCand, "Bullish technical candidate", shape.labelup, location.belowbar, color.new(color.green, 0), text="CE?", textcolor=color.white)
plotshape(bearCand, "Bearish technical candidate", shape.labeldown, location.abovebar, color.new(color.red, 0), text="PE?", textcolor=color.white)
plot(alive ? trig : na, "Trigger", color.blue, 1, style=plot.style_linebr)
plot(alive ? sl : na, "Underlying SL", color.red, 1, style=plot.style_linebr)
plot(alive ? (candBull ? trig + riskPts : trig - riskPts) : na, "T1 (1R)", color.green, 1, style=plot.style_linebr)
plot(alive ? (candBull ? trig + 2 * riskPts : trig - 2 * riskPts) : na, "T2 (2R)", color.green, 1, style=plot.style_linebr)

// ---------------- status table: technical vs EXTERNAL conditions ----------------
yes(b) => b ? "✓" : "✗"
var table t = table.new(position.top_right, 2, 12, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "V1.0 condition", bgcolor=color.new(color.gray, 70))
    table.cell(t, 1, 0, "State", bgcolor=color.new(color.gray, 70))
    table.cell(t, 0, 1, "15m EMA9>20 / <20")
    table.cell(t, 1, 1, emaF15 > emaS15 ? "bull" : "bear")
    table.cell(t, 0, 2, "5m EMA9>20 / <20")
    table.cell(t, 1, 2, emaF > emaS ? "bull" : "bear")
    table.cell(t, 0, 3, "Price vs VWAP")
    table.cell(t, 1, 3, na(vwap) ? "no volume" : close > vwap ? "above" : "below")
    table.cell(t, 0, 4, "Sideways filter")
    table.cell(t, 1, 4, sideways ? "SIDEWAYS" : "trending")
    table.cell(t, 0, 5, "ADX")
    table.cell(t, 1, 5, str.tostring(adx, "#.0"))
    table.cell(t, 0, 6, "Volume confirm (futures)")
    table.cell(t, 1, 6, yes(volConfirm))
    table.cell(t, 0, 7, "Option-chain OI bias / PCR")
    table.cell(t, 1, 7, "EXTERNAL", bgcolor=color.new(color.orange, 60))
    table.cell(t, 0, 8, "Max Pain / OI context")
    table.cell(t, 1, 8, "EXTERNAL", bgcolor=color.new(color.orange, 60))
    table.cell(t, 0, 9, "Delta/Gamma/IV/Theta/liquidity")
    table.cell(t, 1, 9, "EXTERNAL", bgcolor=color.new(color.orange, 60))
    table.cell(t, 0, 10, "Score >= 75")
    table.cell(t, 1, 10, "EXTERNAL (Python)", bgcolor=color.new(color.orange, 60))
    table.cell(t, 0, 11, "Setup C breakout-retest")
    table.cell(t, 1, 11, "Python only")

alertcondition(bullCand, "Bullish technical candidate (V1.0)", "TECHNICAL CANDIDATE ONLY — bullish {{ticker}} {{interval}}m at {{close}}. NOT a trade: the Python engine must validate option-chain, Greeks, liquidity, score and risk before any CE entry.")
alertcondition(bearCand, "Bearish technical candidate (V1.0)", "TECHNICAL CANDIDATE ONLY — bearish {{ticker}} {{interval}}m at {{close}}. NOT a trade: the Python engine must validate option-chain, Greeks, liquidity, score and risk before any PE entry.")
